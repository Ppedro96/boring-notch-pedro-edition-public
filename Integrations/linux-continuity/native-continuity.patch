+import hashlib, json, os, pathlib, signal, subprocess, sys, time
+from concurrent.futures import ThreadPoolExecutor
+root = pathlib.Path(sys.argv[sys.argv.index('--config') + 1]).parent
+signal.signal(signal.SIGTERM, signal.SIG_IGN)
+count = 0
+print(json.dumps({'event':'connection','state':'online'}), flush=True)
+def process(value, index):
+    reply = {'id': value['id'], 'ok': True}
+    if value['op'] == 'occupy':
+        (root / 'busy').write_text('ready')
+        while not (root / 'release-worker').exists(): time.sleep(.01)
+    if value['op'] == 'stage_file':
+        (root / ('started' + str(index))).write_text('ready')
+        gate = root / ('release' + str(index))
+        while not gate.exists(): time.sleep(.01)
+        data = pathlib.Path(value['path']).read_bytes()
+        (root / ('read' + str(index))).write_bytes(data)
+        reply['ok'] = gate.read_text() != 'failure'
+        reply['blob'] = {'sha256':hashlib.sha256(data).hexdigest(),'size':len(data),'name':'image.png'}
+    print(json.dumps(reply), flush=True)
+with ThreadPoolExecutor(max_workers=1) as executor:
+    for line in sys.stdin:
+        value = json.loads(line)
+        if value['op'] == 'crash':
+            child = subprocess.Popen([sys.executable, '-c',
+                'import signal,time,pathlib,sys; signal.signal(signal.SIGTERM,signal.SIG_IGN); pathlib.Path(sys.argv[1]).write_text("ready"); time.sleep(90)', str(root / 'child-ready')])
+            (root / 'child-pid').write_text(str(child.pid))
+            while not (root / 'child-ready').exists(): time.sleep(.01)
+            os._exit(3)
+        if value['op'] == 'stage_file':
+            count += 1
+            (root / ('queued' + str(count))).write_text('accepted')
+        executor.submit(process, value, count)
+)PY"));
+    ContinuityProvider provider(cfg, fixture);
+    provider.start();
+    QTRY_COMPARE(provider.state(), QString("online"));
+    ClipboardStore store(root.path() + "/history");
+    store.setContinuity(&provider);
+    const auto bytes = pngBytes();
+    const auto id = store.recordImage(bytes);
+    const bool timeout = outcome.startsWith("timeout-");
+    if (timeout) {
+        provider.request({ { "op", "occupy" } });
+        QTRY_VERIFY(QFile::exists(root.path() + "/busy"));
+    }
+    store.share(id);
+    QTRY_VERIFY(QFile::exists(root.path() + (timeout ? "/queued1" : "/started1")));
+    auto replies = std::make_shared<int>(0);
+    auto deadlineFailure = std::make_shared<bool>(false);
+    if (timeout) {
+        QVERIFY(!QFile::exists(root.path() + "/started1"));
+        QCOMPARE(provider.m_unsettled.size(), 1);
+        auto& pending = provider.m_pending[provider.m_unsettled.keys().first()];
+        const auto original = pending.callback;
+        pending.callback = [original, replies, deadlineFailure](const QVariantMap& reply) {
+            ++*replies;
+            *deadlineFailure = !reply.value("ok").toBool()
