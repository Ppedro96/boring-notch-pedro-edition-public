+QSet<QString> ClipboardStore::imageReferences(const QVariantList& items) const
+{
+    QSet<QString> result;
+    for (const auto& value : items) {
+        const auto item = value.toMap();
+        if (item.value("kind") != "image")
+            continue;
+        const auto path = item.value("path").toString();
+        if (!path.isEmpty())
+            result.insert(QDir::cleanPath(QFileInfo(path).absoluteFilePath()));
+        // A shared row can reference the same owned bytes without carrying a local path.
+        result.insert(QDir(m_dataRoot).absoluteFilePath(
+            "clipboard-images/" + item.value("id").toString() + ".png"));
+    }
+    return result;
+}
+void ClipboardStore::scheduleImageCleanup()
+{
+    if (m_imageIterator)
+        m_imageCleanupAgain = true;
+    else if (!m_imageCleanupTimer->isActive())
+        m_imageCleanupTimer->start(250);
+}
+void ClipboardStore::cleanImageCacheSlice()
+{
+    const auto directory = QDir(m_dataRoot).absoluteFilePath("clipboard-images");
+    const QFileInfo rootInfo(m_dataRoot), directoryInfo(directory);
+    // Never follow a substituted cache directory or a symlink entry into somebody else's data.
+    if (!m_historyReadable || rootInfo.isSymLink() || directoryInfo.isSymLink()
+        || !directoryInfo.isDir()) {
+        m_imageIterator.reset();
+        m_imageCleanupAgain = false;
+        return;
+    }
+    if (!m_imageIterator)
+        m_imageIterator = std::make_unique<QDirIterator>(directory,
+            QDir::AllEntries | QDir::Hidden | QDir::System | QDir::NoDotAndDotDot);
+    auto referenced = imageReferences(m_items);
+    referenced.unite(m_persistedImagePaths);
+    static const QRegularExpression ownedName(
+        QRegularExpression::anchoredPattern(QStringLiteral("[0-9a-f]{64}\\.png")));
+    QElapsedTimer elapsed;
+    elapsed.start();
+    int visited = 0;
+    // Entry and time budgets avoid a large old cache monopolizing the event loop.
+    while (visited < 64 && elapsed.elapsed() < 4 && m_imageIterator->hasNext()) {
+        ++visited;
+        const auto path = m_imageIterator->next();
+        const QFileInfo file(path);
+        if (!ownedName.match(file.fileName()).hasMatch() || file.isSymLink() || !file.isFile()
+            || referenced.contains(path) || m_imageTransfers.contains(path))
+            continue;
+        if (QFileInfo(directory).isSymLink() || QFileInfo(m_dataRoot).isSymLink())
+            break;
+        QFile::remove(path);
+    }
+    if (m_imageIterator->hasNext()) {
+        m_imageCleanupTimer->start(25);
+        return;
+    }
+    m_imageIterator.reset();
+    if (m_imageCleanupAgain) {
+        m_imageCleanupAgain = false;
+        scheduleImageCleanup();
+    }
+}
