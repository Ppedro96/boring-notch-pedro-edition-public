+void ClipboardStoreTest::failedSavePreservesDurableReferences()
+{
+    QTemporaryDir root;
+    const auto bytes = pngBytes();
+    ClipboardStore store(root.path());
+    const auto id = store.recordImage(bytes);
+    const auto history = root.path() + "/clipboard.json";
+    const auto saved = readBytes(history);
+    QVERIFY(QFile::rename(history, history + ".saved"));
+    // A directory at the target forces QSaveFile commit/open failure even as a privileged user.
+    QVERIFY(QDir().mkdir(history));
+    store.remove(id);
+    QTest::qWait(400);
+    QVERIFY(store.items().isEmpty());
+    QCOMPARE(readBytes(cachePath(root.path(), bytes)), bytes);
+    QCOMPARE(readBytes(history + ".saved"), saved);
+    QVERIFY(QDir().rmdir(history));
+    QVERIFY(QFile::rename(history + ".saved", history));
+    store.recordText("successful metadata retry");
+    QTRY_VERIFY(!QFile::exists(cachePath(root.path(), bytes)));
+}
