+namespace {
+constexpr qsizetype maxFrame = 1024 * 1024;
+double now() { return QDateTime::currentMSecsSinceEpoch() / 1000.0; }
+QString uuid() { return QUuid::createUuid().toString(QUuid::WithoutBraces); }
+QString limited(const QVariant& v, int n = 512) { return v.toString().left(n); }
+QString taskStatus(const QString& raw)
+{
+    const auto value = raw.toLower();
+    if (QStringList { "lifecycle", "status", "running", "working", "in_progress" }.contains(value))
+        return "working";
+    if (QStringList { "completion", "complete", "completed", "done", "success" }.contains(value))
+        return "completed";
+    if (QStringList { "failed", "error" }.contains(value))
+        return "failed";
+    if (QStringList { "cancelled", "canceled" }.contains(value))
+        return "cancelled";
+    if (value == "waiting")
+        return "waiting";
+    if (QStringList { "queued", "pending" }.contains(value))
+        return "queued";
+    return "unknown";
+}
+bool technicalTaskTitle(const QString& title, const QString& event)
+{
+    return title.isEmpty() || (!event.isEmpty() && title.compare(event, Qt::CaseInsensitive) == 0)
+        || QStringList { "stop", "sessionstart", "sessionend", "subagentstop", "taskcompleted",
+               "event" }
+               .contains(title.toLower());
+}
+double eventTime(const QVariantMap& event)
+{
+    double stamp = event.value("createdAt").toDouble();
+    if (stamp > 1e11)
+        stamp /= 1000;
+    if (stamp <= 0)
+        stamp = QDateTime::fromString(event.value("createdAt").toString(), Qt::ISODateWithMs)
+                    .toMSecsSinceEpoch()
+            / 1000.0;
+    return stamp;
+}
+}
+ContinuityProvider::ContinuityProvider(
+    const QString& config, const QString& script, QObject* parent)
+    : QObject(parent)
+{
+    const auto root = QDir::homePath() + "/.local/share/insight-notch-linux/desk/";
+    m_config = config.isEmpty() ? root + "continuity/config.json" : config;
+    m_script = script.isEmpty() ? root + "continuity-client.py" : script;
+    QFile file(m_config);
+    if (file.open(QIODevice::ReadOnly)) {
+        auto value = QJsonDocument::fromJson(file.read(65537)).object();
+        m_enabled = value.value("enabled").isBool() && value.value("enabled").toBool();
+        m_peer = value.value("peer").toString();
+    }
+    m_selectedHost = m_peer;
+    connect(&m_process, &QProcess::readyReadStandardOutput, this, &ContinuityProvider::readOutput);
+    connect(&m_process, &QProcess::readyReadStandardError, this,
+        [this] { m_process.readAllStandardError(); });
+    connect(&m_process, qOverload<int, QProcess::ExitStatus>(&QProcess::finished), this,
+        [this](int, QProcess::ExitStatus) { cleanup(!m_stopping); });
+    connect(&m_process, &QProcess::errorOccurred, this, [this](QProcess::ProcessError error) {
+        if (error == QProcess::FailedToStart)
+            cleanup(!m_stopping);
+    });
+    m_restart.setSingleShot(true);
+    connect(&m_restart, &QTimer::timeout, this, &ContinuityProvider::start);
+    m_cleanup.setInterval(100);
+    connect(&m_cleanup, &QTimer::timeout, this, &ContinuityProvider::finishCleanup);
+    m_deadlines.setInterval(250);
+    connect(&m_deadlines, &QTimer::timeout, this, [this] {
+        const auto time = QDateTime::currentMSecsSinceEpoch();
+        for (const auto& id : m_pending.keys())
+            if (m_pending.value(id).deadline < time) {
+                auto p = m_pending.take(id);
+                if (p.callback)
+                    p.callback({ { "ok", false }, { "error", "Tempo esgotado" } });
+            }
+    });
+    m_deadlines.start();
+    m_mediaExpiry.setInterval(1000);
+    connect(&m_mediaExpiry, &QTimer::timeout, this, [this] {
+        auto labels = QJsonDocument::fromVariant(mediaSources()).toJson(QJsonDocument::Compact);
+        if (labels != m_sourceLabels) {
+            m_sourceLabels = labels;
+            emit changed();
+        }
+    });
+    if (m_enabled)
+        m_mediaExpiry.start();
+    m_heartbeat.setInterval(15000);
+    connect(&m_heartbeat, &QTimer::timeout, this, [this] {
+        publishMedia();
+        emit changed();
+    });
+}
+ContinuityProvider::~ContinuityProvider()
+{
+    stop();
+    // Destructor is bounded and still uses the independently verified group after leader exit.
+    if (m_ownedGroup > 0) {
+        m_groupKilled = ::kill(-m_ownedGroup, SIGKILL) == 0 || errno == ESRCH;
+        if (m_groupKilled)
+            m_ownedGroup = 0;
+    }
+    if (m_process.state() != QProcess::NotRunning) {
+        m_process.kill();
+        m_process.waitForFinished(1000);
+    }
+    if (m_ownedGroup <= 0 && m_process.state() == QProcess::NotRunning)
+        settleRequests();
+}
+void ContinuityProvider::start()
+{
+    if (!m_enabled || m_cleaning || m_process.state() != QProcess::NotRunning)
+        return;
+    m_stopping = false;
+    m_handshake = false;
+    m_buffer.clear();
+    m_state = "connecting";
+    emit changed();
+    // Child cannot execute the bridge/spawn descendants until its group is verified and
+    // acknowledged.
+    const QString launcher
+        = "import "
+          "os,sys,runpy,json\nos.setsid()\nprint(json.dumps({'event':'native_group','pid':os."
+          "getpid()}),flush=True)\nif sys.stdin.buffer.readline()!=b'GO\\n': "
+          "sys.exit(1)\nsys.argv=sys.argv[1:]\nsys.path.insert(0,os.path.dirname(sys.argv[0]))"
+          "\nrunpy.run_path(sys.argv[0],run_name='__main__')\n";
+    m_process.start(
+        "/usr/bin/python3", { "-u", "-c", launcher, m_script, "--stdio", "--config", m_config });
+    QTimer::singleShot(3000, this, [this] {
+        if (!m_handshake && m_process.state() != QProcess::NotRunning)
+            cleanup(true);
+    });
+}
+void ContinuityProvider::stop()
+{
+    m_stopping = true;
+    m_restart.stop();
+    m_heartbeat.stop();
+    cleanup(false);
+}
+void ContinuityProvider::failPending(const QString& reason)
+{
+    auto pending = std::move(m_pending);
+    m_pending.clear();
+    for (const auto& p : pending)
+        if (p.callback)
+            p.callback({ { "ok", false }, { "error", reason } });
+}
+void ContinuityProvider::settleRequests()
+{
+    auto unsettled = std::move(m_unsettled);
+    m_unsettled.clear();
+    for (const auto& settled : unsettled)
+        settled();
+}
+void ContinuityProvider::cleanup(bool restart)
+{
+    if (!restart)
+        m_stopping = true;
+    if (m_cleaning)
+        return;
+    m_cleaning = true;
+    m_handshake = false;
+    m_state = m_enabled ? "offline" : "disabled";
+    m_heartbeat.stop();
+    failPending("Conexão encerrada");
+    emit changed();
+    if (m_ownedGroup > 0)
+        ::kill(-m_ownedGroup, SIGTERM);
+    else if (m_process.state() != QProcess::NotRunning)
+        m_process.terminate();
+    m_groupKilled = false;
+    m_cleanupTicks = 0;
+    m_cleanup.start();
+}
+void ContinuityProvider::finishCleanup()
+{
+    ++m_cleanupTicks;
+    if (m_cleanupTicks >= 3 && !m_groupKilled) {
+        if (m_ownedGroup > 0)
+            m_groupKilled = ::kill(-m_ownedGroup, SIGKILL) == 0 || errno == ESRCH;
+        if (m_process.state() != QProcess::NotRunning)
+            m_process.kill();
+    }
+    bool groupGone = m_ownedGroup <= 0 || (::kill(-m_ownedGroup, 0) < 0 && errno == ESRCH);
+    if (m_process.state() != QProcess::NotRunning
+        || (!groupGone && (!m_groupKilled || m_cleanupTicks < 12)))
+        return;
+    // After bounded escalation no executable member can remain; zombies may await system reaping.
+    m_cleanup.stop();
+    m_ownedGroup = 0;
+    m_cleaning = false;
+    m_buffer.clear();
+    settleRequests();
+    if (!m_stopping) {
+        m_restart.start(m_restartDelay);
+        m_restartDelay = std::min(5000, m_restartDelay * 2);
+    }
+}
+void ContinuityProvider::request(
+    QVariantMap value, Reply callback, int timeoutMs, std::function<void()> settled)
+{
+    if (!m_enabled || !m_handshake || m_cleaning) {
+        if (callback)
+            callback({ { "ok", false }, { "error", "Continuidade indisponível" } });
+        if (settled)
+            settled();
+        return;
+    }
+    qsizetype outstanding = m_pending.size();
+    for (auto it = m_unsettled.cbegin(); it != m_unsettled.cend(); ++it)
+        if (!m_pending.contains(it.key()))
+            ++outstanding;
+    if (outstanding >= 32 || m_process.bytesToWrite() > 2 * maxFrame) {
+        if (callback)
+            callback({ { "ok", false }, { "error", "Integração ocupada" } });
+        if (settled)
+            settled();
+        return;
+    }
+    const auto id = uuid();
+    value["id"] = id;
+    value["timeout"] = std::max(1, timeoutMs / 1000);
+    auto data = QJsonDocument::fromVariant(value).toJson(QJsonDocument::Compact);
+    if (data.size() > maxFrame) {
+        if (callback)
+            callback({ { "ok", false }, { "error", "Conteúdo excede o limite" } });
+        if (settled)
+            settled();
+        return;
+    }
+    m_pending.insert(id, { callback, QDateTime::currentMSecsSinceEpoch() + timeoutMs });
+    if (settled)
+        m_unsettled.insert(id, std::move(settled));
+    m_process.write(data + '\n');
+}
+void ContinuityProvider::readOutput()
+{
+    while (m_process.bytesAvailable() > 0) {
+        m_buffer += m_process.read(std::min<qint64>(65536, m_process.bytesAvailable()));
+        qsizetype end;
+        while ((end = m_buffer.indexOf('\n')) >= 0) {
+            if (end > maxFrame) {
+                cleanup(true);
+                return;
+            }
+            auto line = m_buffer.left(end);
+            m_buffer.remove(0, end + 1);
+            auto doc = QJsonDocument::fromJson(line);
+            if (!doc.isObject()) {
+                cleanup(true);
+                return;
+            }
+            handleFrame(doc.object().toVariantMap());
+            if (m_cleaning)
+                return;
+        }
+        if (m_buffer.size() > maxFrame) {
+            cleanup(true);
+            return;
+        }
+    }
+}
+void ContinuityProvider::handleFrame(const QVariantMap& frame)
+{
+    if (frame.value("event") == "native_group" && !m_handshake) {
+        auto pid = m_process.processId();
+        if (pid <= 1 || frame.value("pid").toLongLong() != pid || ::getpgid(pid) != pid
+            || ::getsid(pid) != pid) {
+            cleanup(true);
+            return;
+        }
+        m_ownedGroup = int(pid);
+        m_handshake = true;
+        m_process.write("GO\n");
+        request({ { "op", "watch" } });
+        return;
+    }
+    if (!m_handshake)
+        return;
+    if (frame.contains("id")) {
+        const auto id = frame.value("id").toString();
+        auto p = m_pending.take(id);
+        auto settled = m_unsettled.take(id);
+        if (p.callback)
+            p.callback(frame);
+        if (settled)
+            settled();
+        return;
+    }
+    const auto event = frame.value("event").toString();
+    if (event == "connection") {
+        m_state = frame.value("state").toString();
+        if (m_state == "online") {
+            m_restartDelay = 200;
+            publishMedia();
+            m_heartbeat.start();
+        }
+        emit changed();
+    } else if (event == "snapshot") {
+        auto topic = frame.value("topic").toString();
+        if (!QStringList { "clipboard", "shelf", "links", "alerts", "tasks", "media", "desk" }
+                .contains(topic))
+            return;
+        if (frame.value("revision").toLongLong() < m_revisions.value(topic))
+            return;
+        m_revisions[topic] = frame.value("revision").toLongLong();
+        m_items[topic] = frame.value("items").toList();
+        emit snapshotReceived(frame);
+        emit changed();
+    } else if (event == "mutation_error")
+        feedback(frame.value("error").toString());
+    else if (event == "command") {
+        const auto id = frame.value("commandId").toString();
+        const auto action = frame.value("action").toString();
+        if (id.isEmpty() || m_seenCommands.contains(id))
+            return;
+        if (m_seenCommands.size() > 1024)
+            m_seenCommands.clear();
+        m_seenCommands.insert(id);
+        const bool valid = frame.value("target").toString() == m_peer
+            && frame.value("expiresAt").toDouble() > now()
+            && m_localMedia.value("available").toBool()
+            && QStringList { "play", "pause", "toggle", "next", "previous", "seek", "raise" }
+                   .contains(action);
+        if (valid)
+            emit localMediaCommand(action, frame.value("arguments").toMap(), id);
+        else
+            acknowledge(id, false, "Comando expirado ou player indisponível");
+    }
+}
+void ContinuityProvider::mutate(const QString& op, const QString& topic, const QString& key,
+    const QVariantMap& payload, Reply callback)
+{
+    QVariantMap value { { "op", op }, { "topic", topic }, { "key", key }, { "mutationId", uuid() },
+        { "expectedRevision", revision(topic) } };
+    if (op != "delete")
+        value["payload"] = payload;
+    request(value, [this, callback](const QVariantMap& reply) {
+        if (!reply.value("ok").toBool())
+            feedback(reply.value("error").toString());
+        if (callback)
+            callback(reply);
+    });
+}
+void ContinuityProvider::feedback(const QString& value)
+{
+    m_message = value.left(300);
+    emit changed();
+}
+QString ContinuityProvider::contentKey(const QByteArray& bytes)
+{
+    return QString::fromLatin1(QCryptographicHash::hash(bytes, QCryptographicHash::Sha256).toHex());
+}
+bool ContinuityProvider::privateFormats(const QStringList& formats)
+{
+    if (formats.isEmpty())
+        return true;
+    for (auto f : formats) {
+        f = f.toLower();
+        for (const auto& word : QStringList { "password", "concealed", "transient", "autogenerated",
+                 "private", "secret", "onlyreplaceempty", "org.nspasteboard" })
+            if (f.contains(word))
+                return true;
+    }
+    return false;
+}
+bool ContinuityProvider::freshClipboard(
+    const QVariantMap& f, const QVariantMap& item, const QString& peer, double time, double last)
+{
+    auto p = item.value("payload").toMap();
+    double captured = p.value("capturedAt").toDouble();
+    return !f.value("initial").toBool() && !f.value("cached").toBool()
+        && !f.value("replayed").toBool()
+        && f.value("changed").toStringList().contains(item.value("id").toString())
+        && item.value("origin").toString() != peer && captured > last && captured <= time
+        && time - captured <= 30;
+}
+bool ContinuityProvider::mediaFresh(const QVariantMap& p, double time)
+{
+    double stamp = p.value("updatedAt").toDouble();
+    return p.value("available").toBool() && stamp <= time && time - stamp <= 35;
+}
+QVariantMap ContinuityProvider::find(const QString& topic, const QString& key) const
+{
+    for (const auto& v : items(topic))
+        if (v.toMap().value("id").toString() == key)
+            return v.toMap();
+    return {};
+}
+QVariantList ContinuityProvider::tasks() const
+{
+    QVariantList out;
+    for (const auto& v : items("tasks")) {
+        auto item = v.toMap();
+        if (item.value("origin").toString() != m_peer)
+            out << item;
+    }
+    // Presentation only: retain the original shared snapshot and every historical row.
+    std::stable_sort(out.begin(), out.end(), [](const QVariant& a, const QVariant& b) {
+        const auto left = a.toMap(), right = b.toMap();
+        const auto lp = left.value("payload").toMap(), rp = right.value("payload").toMap();
+        const QStringList terminal { "completed", "failed", "cancelled" };
+        const bool lt = terminal.contains(taskStatus(lp.value("status").toString()));
+        const bool rt = terminal.contains(taskStatus(rp.value("status").toString()));
+        if (lt != rt)
+            return !lt;
+        const auto ls = lp.value("updatedAt").toDouble(), rs = rp.value("updatedAt").toDouble();
+        if (ls != rs)
+            return ls > rs;
+        return left.value("id").toString() < right.value("id").toString();
+    });
+    return out;
+}
+QVariantList ContinuityProvider::mediaSources() const
+{
+    QVariantList result { QVariantMap { { "host", m_peer }, { "label", "Local" } } };
+    for (const auto& v : items("media")) {
+        auto item = v.toMap();
+        auto host = item.value("id").toString();
+        if (host != m_peer)
+            result << QVariantMap { { "host", host },
+                { "label",
+                    host
+                        + (mediaFresh(item.value("payload").toMap(), now())
+                                ? ""
+                                : " · indisponível") } };
+    }
+    return result;
+}
+QVariantMap ContinuityProvider::selectedMedia() const
+{
+    if (m_selectedHost == m_peer || m_selectedHost.isEmpty())
+        return m_localMedia;
+    auto payload = find("media", m_selectedHost).value("payload").toMap();
+    payload["available"] = m_state == "online" && mediaFresh(payload, now());
+    return payload;
+}
+void ContinuityProvider::selectHost(const QString& host)
+{
+    m_selectedHost = host;
+    emit changed();
+}
+void ContinuityProvider::setLocalMedia(const QVariantMap& snapshot)
+{
+    m_localMedia = snapshot;
+    m_localMedia["duration"] = snapshot.value("durationSeconds");
+    m_localMedia["position"] = snapshot.value("positionSeconds");
+    QVariantMap fingerprint = snapshot;
+    fingerprint.remove("position");
+    fingerprint.remove("progress");
+    fingerprint.remove("positionSeconds");
+    auto data = QJsonDocument::fromVariant(fingerprint).toJson(QJsonDocument::Compact);
+    if (data != m_mediaFingerprint) {
+        m_mediaFingerprint = data;
+        publishMedia();
+    }
+    emit changed();
+}
+void ContinuityProvider::publishMedia()
+{
+    if (!m_enabled || m_state != "online")
+        return;
+    QVariantMap payload { { "host", m_peer }, { "title", limited(m_localMedia.value("title")) },
+        { "artist", limited(m_localMedia.value("artist")) },
+        { "album", limited(m_localMedia.value("album")) },
+        { "playing", m_localMedia.value("playing").toBool() },
+        { "duration", m_localMedia.value("duration").toDouble() },
+        { "position", m_localMedia.value("position").toDouble() },
+        { "available", m_localMedia.value("available").toBool() }, { "updatedAt", now() } };
+    mutate("put", "media", m_peer, payload);
+}
+void ContinuityProvider::mediaAction(const QString& action, double position)
+{
+    if (m_selectedHost == m_peer || m_selectedHost.isEmpty()) {
+        emit localMediaCommand(action, { { "position", position } }, {});
+        return;
+    }
+    if (!selectedMedia().value("available").toBool()) {
+        feedback("Player remoto indisponível");
+        return;
+    }
+    request({ { "op", "send_command" }, { "target", m_selectedHost }, { "action", action },
+                { "arguments", QVariantMap { { "position", std::max(0.0, position) } } } },
+        [this](const QVariantMap& r) {
+            if (!r.value("ok").toBool())
+                feedback(r.value("error").toString());
+        });
+}
+void ContinuityProvider::acknowledge(const QString& id, bool ok, const QString& error)
+{
+    if (!id.isEmpty())
+        request({ { "op", "ack_command" }, { "commandId", id }, { "ok", ok }, { "error", error } });
+}
+void ContinuityProvider::publishTasks(const QVariantList& sessions)
+{
+    if (!m_enabled || !m_handshake)
+        return;
+    auto ordered = sessions;
+    std::stable_sort(ordered.begin(), ordered.end(), [](const QVariant& a, const QVariant& b) {
+        return eventTime(a.toMap()) > eventTime(b.toMap());
+    });
+    QSet<QString> seen;
+    for (const auto& v : ordered) {
+        auto s = v.toMap();
+        auto kind = s.value("kind").toString().toLower();
+        // Approval/question events often place the full prompt in title. Never publish those
+        // fields.
+        if (QStringList { "permission", "approval", "question" }.contains(kind))
+            continue;
+        auto source = s.value("taskId").toString();
+        if (source.isEmpty())
+            source = s.value("sessionId").toString();
+        if (source.isEmpty())
+            source = s.value("threadId").toString();
+        if (source.isEmpty())
+            source = s.value("id").toString();
+        if (source.isEmpty())
+            continue;
+        const auto identity = contentKey((s.value("provider").toString() + ":" + source).toUtf8());
+        const double stamp = eventTime(s);
+        if (stamp <= 0 || seen.contains(identity))
+            continue;
+        seen.insert(identity);
+        const auto shared = find("tasks", m_peer + ":" + identity).value("payload").toMap();
+        if (stamp < m_taskTimes.value(identity) || stamp < shared.value("updatedAt").toDouble())
+            continue;
+        const auto status = taskStatus(s.value("status", kind).toString());
+        auto title = limited(s.value("title"), 240);
+        if (technicalTaskTitle(title, s.value("event").toString()))
+            title = "Sessão de agente";
+        const auto progress = s.value("progress");
+        const double percentage = progress.isValid() && !progress.isNull()
+            ? std::clamp(progress.toDouble(), 0.0, 100.0)
+            : (status == "completed" ? 100.0 : 0.0);
+        QVariantMap p { { "taskId", identity }, { "host", m_peer },
+            { "agent", limited(s.value("provider"), 80) }, { "title", title }, { "status", status },
+            { "progress", percentage }, { "summary", limited(s.value("summary"), 512) },
+            { "updatedAt", stamp } };
+        auto hash = QJsonDocument::fromVariant(p).toJson(QJsonDocument::Compact);
+        if (m_taskHashes.value(identity) == hash || shared == p)
+            continue;
+        m_taskTimes[identity] = stamp;
+        m_taskHashes[identity] = hash;
+        mutate("put", "tasks", m_peer + ":" + identity, p, [this, identity](const QVariantMap& r) {
+            if (!r.value("ok").toBool())
+                m_taskHashes.remove(identity);
+        });
+    }
+}
+void ContinuityProvider::addShelf(const QVariant& value)
+{
+    auto text = value.toString();
+    auto url = QUrl(text);
+    auto key = uuid();
+    QVariantMap p { { "createdAt", now() } };
+    if (url.isLocalFile() || QFileInfo(text).isAbsolute()) {
+        auto path = url.isLocalFile() ? url.toLocalFile() : text;
+        feedback("Enviando arquivo…");
+        p["kind"] = "file";
+        p["name"] = QFileInfo(path).fileName();
+        request(
+            { { "op", "stage_file" }, { "path", path } },
+            [this, key, p](const QVariantMap& r) mutable {
+                if (!r.value("ok").toBool()) {
+                    feedback(r.value("error").toString());
+                    return;
+                }
+                if (m_removedShelf.contains(key))
+                    return;
+                p["blob"] = r.value("blob");
+                mutate("put", "shelf", key, p, [this](const QVariantMap& reply) {
+                    if (reply.value("ok").toBool())
+                        feedback("Arquivo compartilhado");
+                });
+            },
+            3600000);
+    } else if (!text.isEmpty()) {
+        bool link = url.scheme() == "https" || url.scheme() == "http";
+        p["kind"] = link ? "link" : "text";
+        p["name"] = text.left(80);
+        p[link ? "url" : "text"] = text;
+        mutate("put", "shelf", key, p);
+    }
+}
+void ContinuityProvider::removeShared(const QString& topic, const QString& key)
+{
+    if (!QStringList { "shelf", "links", "tasks" }.contains(topic))
+        return;
+    m_removedShelf.insert(key);
+    mutate("delete", topic, key);
+}
+void ContinuityProvider::openShared(const QString& topic, const QString& key, bool download)
+{
+    auto p = find(topic, key).value("payload").toMap();
+    auto blob = p.value("blob").toMap();
+    if (!blob.isEmpty() && (download || p.value("kind") == "file" || topic == "tasks")) {
+        request(
+            { { "op", "fetch_blob" }, { "blob", blob } },
+            [this](const QVariantMap& r) {
+                if (r.value("ok").toBool()) {
+                    auto path = r.value("path").toString();
+                    if (QFileInfo(path).isFile())
+                        QDesktopServices::openUrl(QUrl::fromLocalFile(path));
+                } else
+                    feedback(r.value("error").toString());
+            },
+            3600000);
+    } else {
+        if (p.value("kind") == "text"
+            || (topic == "links" && p.value("url").toString().isEmpty())) {
+            QGuiApplication::clipboard()->setText(
+                p.value(topic == "links" ? "note" : "text").toString());
+            return;
+        }
+        auto url = QUrl(p.value("url").toString());
+        if (QStringList { "https", "http" }.contains(url.scheme()))
+            QDesktopServices::openUrl(url);
+    }
+}
+void ContinuityProvider::publishLink(
+    const QString& title, const QString& url, const QString& note, const QString& path)
+{
+    if (!m_enabled)
+        return;
+    auto key = uuid();
+    QVariantMap p { { "title", title }, { "url", url }, { "note", note }, { "createdAt", now() },
+        { "sync", false } };
+    // First accept metadata, including offline. Optional Markdown is an atomic patch after staging.
+    mutate("put", "links", key, p, [this, key, path](const QVariantMap& r) {
+        if (!r.value("ok").toBool() || m_state != "online" || path.isEmpty())
+            return;
+        request(
+            { { "op", "stage_file" }, { "path", path } }, [this, key](const QVariantMap& stage) {
+                if (stage.value("ok").toBool())
+                    mutate("patch", "links", key, { { "blob", stage.value("blob") } });
+            });
+    });
+}
