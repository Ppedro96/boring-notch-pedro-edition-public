+#include "WaylandClipboardWriter.h"
+#include <csignal>
+#include <sys/prctl.h>
+#include <unistd.h>
+
+WaylandClipboardWriter::WaylandClipboardWriter(QObject* parent)
+    : QObject(parent)
+{
+    // The foreground source can spawn a cat child while serving a paste. Retain its
+    // verified private group even if the leader exits, so stop also retires that child.
+    const auto parentPid = getpid();
+    m_process.setChildProcessModifier([parentPid] {
+        if (setsid() < 0 || prctl(PR_SET_PDEATHSIG, SIGKILL) < 0 || getppid() != parentPid)
+            _exit(127);
+    });
+    m_deadline.setSingleShot(true);
+    connect(&m_deadline, &QTimer::timeout, this, [this] { fail("publication timed out"); });
+    connect(&m_process, &QProcess::readyReadStandardOutput, this,
+        [this] { m_process.readAllStandardOutput(); });
+    connect(&m_process, &QProcess::readyReadStandardError, this,
+        [this] { m_process.readAllStandardError(); });
+    connect(&m_process, &QProcess::started, this, [this] {
+        if (m_stopping) {
+            m_process.kill();
+            return;
+        }
+        const auto pid = m_process.processId();
+        if (pid <= 1 || getpgid(pid) != pid || getsid(pid) != pid) {
+            fail("unverified writer group");
+            return;
+        }
+        m_group = pid;
+        if (m_process.write(m_bytes) != m_bytes.size()) {
+            fail("writer input rejected");
+            return;
+        }
+        m_bytes.clear();
+        checkPrepared();
+    });
+    connect(&m_process, &QProcess::bytesWritten, this, [this] { checkPrepared(); });
+    connect(&m_process, &QProcess::errorOccurred, this,
+        [this](QProcess::ProcessError) { fail("writer process error"); });
+    connect(&m_process, qOverload<int, QProcess::ExitStatus>(&QProcess::finished), this,
+        [this](int code, QProcess::ExitStatus status) {
+            if (m_group > 1)
+                kill(-m_group, SIGKILL);
+            m_group = 0;
+            m_deadline.stop();
+            m_released = m_committed && code == 0 && status == QProcess::NormalExit;
+            if (!m_stopping && !m_confirmed && !m_released)
+                fail("writer exited before verification");
+            emit finished();
+        });
+}
+WaylandClipboardWriter::~WaylandClipboardWriter()
+{
+    stop();
+    if (m_process.state() != QProcess::NotRunning)
+        m_process.waitForFinished(250);
+}
+void WaylandClipboardWriter::start(
+    const QString& program, const QByteArray& bytes, const QString& mime)
+{
+    if (m_process.state() != QProcess::NotRunning || m_stopping)
+        return;
+    if (bytes.isEmpty() || bytes.size() > 20 * 1024 * 1024
+        || (mime != "image/png" && mime != "text/plain;charset=utf-8")) {
+        fail("invalid clipboard payload");
+        return;
+    }
+    m_bytes = bytes;
+    m_deadline.start(2500);
+    m_process.start(program, { "--foreground", "--type", mime });
+}
+void WaylandClipboardWriter::checkPrepared()
+{
+    if (m_prepared || m_stopping || !m_group || m_process.bytesToWrite() != 0)
+        return;
+    m_prepared = true;
+    emit prepared();
+}
+void WaylandClipboardWriter::commit()
+{
+    if (!m_prepared || m_committed || !running())
+        return;
+    m_committed = true;
+    m_deadline.start(5000);
+    m_process.closeWriteChannel();
+}
+void WaylandClipboardWriter::confirm()
+{
+    if (m_committed && (running() || selectionReleased())) {
+        m_confirmed = true;
+        m_deadline.stop();
+    }
+}
+bool WaylandClipboardWriter::running() const
+{
+    return !m_stopping && m_process.state() == QProcess::Running;
+}
+void WaylandClipboardWriter::fail(const QString& reason)
+{
+    if (m_stopping)
+        return;
+    stop();
+    emit failed(reason);
+}
+void WaylandClipboardWriter::stop()
+{
+    if (m_stopping)
+        return;
+    m_stopping = true;
+    m_deadline.stop();
+    m_bytes.clear();
+    if (m_group > 1)
+        kill(-m_group, SIGKILL);
+    if (m_process.state() != QProcess::NotRunning)
+        m_process.kill();
+}
