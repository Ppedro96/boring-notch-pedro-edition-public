+QString ClipboardStore::waylandCopyProgram() const { return "/usr/bin/wl-copy"; }
+void ClipboardStore::stopWaylandWriters()
+{
+    ++m_generation;
+    for (const auto& writer : { m_pendingWriter, m_activeWriter })
+        if (writer) {
+            writer->disconnect(this);
+            writer->stop();
+            delete writer;
+        }
+    m_pendingWriter = nullptr;
+    m_activeWriter = nullptr;
+    m_applying = false;
+}
+// Read MIME -> exact bytes -> MIME. Never use cached Qt data as Wayland offer provenance.
+void ClipboardStore::readWaylandOffer(std::function<void(bool, QByteArray)> done)
+{
+    QPointer<ClipboardStore> guard(this);
+    readWayland({ "--list-types" }, 16384, [this, guard, done](bool ok, QByteArray list) {
+        if (!guard)
+            return;
+        const auto offered = formats(list);
+        if (!ok || ContinuityProvider::privateFormats(offered)) {
+            done(false, {});
+            return;
+        }
+        QString type;
+        if (offered.contains("image/png"))
+            type = "image/png";
+        else if (offered.contains("text/plain;charset=utf-8"))
+            type = "text/plain;charset=utf-8";
+        else if (offered.contains("text/plain"))
+            type = "text/plain";
+        if (type.isEmpty()) {
+            done(false, {});
+            return;
+        }
+        readWayland({ "--no-newline", "--type", type },
+            type == "image/png" ? 20 * 1024 * 1024 : 256 * 1024,
+            [this, guard, offered, done](bool ok, QByteArray data) {
+                if (!guard)
+                    return;
+                if (!ok) {
+                    done(false, {});
+                    return;
+                }
+                readWayland({ "--list-types" }, 16384,
+                    [guard, offered, data, done](bool ok, QByteArray after) {
+                        if (guard)
+                            done(ok && formats(after) == offered, data);
+                    });
+            });
+    });
+}
+void ClipboardStore::cancelWaylandWrite(const QString& id, const QString& reason)
+{
+    if (!m_pendingWriter)
+        return;
+    auto writer = m_pendingWriter;
+    m_pendingWriter = nullptr;
+    writer->stop();
+    writer->deleteLater();
+    m_applying = false;
+    // No clipboard bytes or untrusted subprocess diagnostics in the journal.
+    qWarning("Wayland clipboard publication failed: %s", qPrintable(reason));
+    emit applicationFinished(id, false);
+}
+void ClipboardStore::writeWayland(const QByteArray& bytes, const QString& mime, const QString& id,
+    const QString& observed, quint64 generation, bool automatic, qint64 timestamp)
+{
+    if (m_pendingWriter) {
+        m_pendingWriter->stop();
+        m_pendingWriter->deleteLater();
+    }
+    QPointer<WaylandClipboardWriter> writer = new WaylandClipboardWriter(this);
+    m_pendingWriter = writer;
+    m_applying = true;
+    connect(writer.data(), &WaylandClipboardWriter::failed, this,
+        [this, writer, id](const QString& reason) {
+            if (m_pendingWriter == writer)
+                cancelWaylandWrite(id, reason);
+        });
+    connect(writer.data(), &WaylandClipboardWriter::finished, this,
+        [this, writer, id, observed, generation] {
+            if (m_pendingWriter == writer) {
+                verifyWaylandWrite(writer, id, observed, generation);
+                return;
+            }
+            if (m_activeWriter == writer)
+                m_activeWriter = nullptr;
+            writer->deleteLater();
+        });
+    connect(writer.data(), &WaylandClipboardWriter::prepared, this,
+        [this, writer, id, observed, generation, automatic, timestamp] {
+            auto release = [this, writer, id, observed, generation, automatic, timestamp](bool ok) {
+                if (!writer || m_pendingWriter != writer)
+                    return;
+                bool exists = false;
+                for (const auto& v : m_items)
+                    exists |= v.toMap().value("id") == id;
+                if (!ok || !exists || generation != m_generation || !m_clipboard
+                    || (automatic && nowOr(-1) - timestamp > 30000)) {
+                    cancelWaylandWrite(id, "current clipboard changed before publication");
+                    return;
+                }
+                writer->commit();
+                QTimer::singleShot(75, this, [this, writer, id, observed, generation] {
+                    verifyWaylandWrite(writer, id, observed, generation);
+                });
+            };
+            if (!automatic) {
+                release(true);
+                return;
+            }
+            // wl-copy does not set selection until stdin EOF. Recheck after process startup
+            // and bounded input transfer, immediately before releasing that EOF.
+            readWaylandOffer([observed, release](bool ok, QByteArray data) {
+                release(ok && key(data) == observed);
+            });
+        });
+    writer->start(waylandCopyProgram(), bytes, mime);
+}
+void ClipboardStore::verifyWaylandWrite(QPointer<WaylandClipboardWriter> writer, const QString& id,
+    const QString& observed, quint64 generation)
+{
+    if (!writer || m_pendingWriter != writer)
+        return;
+    readWaylandOffer([this, writer, id, observed, generation](bool ok, QByteArray data) {
+        if (!writer || m_pendingWriter != writer)
+            return;
+        if (generation != m_generation || (!writer->running() && !writer->selectionReleased())
+            || !ok) {
+            cancelWaylandWrite(id, "clipboard verification interrupted");
+            return;
+        }
+        const auto current = key(data);
+        if (current == id) {
+            writer->confirm();
+            // Keep the previous selection source alive until its replacement is verified.
+            if (m_activeWriter) {
+                m_activeWriter->stop();
+                m_activeWriter->deleteLater();
+            }
+            m_activeWriter = writer->running() ? writer : nullptr;
+            if (!writer->running())
+                writer->deleteLater();
+            m_pendingWriter = nullptr;
+            m_lastObservedKey = id;
+            m_lastCapture = nowOr(-1) / 1000.0;
+            m_applying = false;
+            emit applicationFinished(id, true);
+        } else if (current == observed && writer->running()) {
