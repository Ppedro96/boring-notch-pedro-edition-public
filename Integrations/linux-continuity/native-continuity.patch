+bool AlertsProvider::sharedAlert(const QVariantMap &alert) const {
+ const auto source=alert.value("source").toString().toLower();const auto id=alert.value("id").toString().toLower();
+ if(source.isEmpty()||id.isEmpty())return false;
+ for(const auto &local:QStringList{"mac","linux","x99","windows","alienware","local","ssh","usage"})
+  if(source==local||id.startsWith(local+"."))return false;
+ return true;
+}
+void AlertsProvider::setContinuity(ContinuityProvider *provider){
+ m_continuity=provider;if(provider)connect(provider,&ContinuityProvider::snapshotReceived,this,[this](const QVariantMap &f){if(f.value("topic")=="alerts")mergeAcknowledgements();});
+}
+void AlertsProvider::publishDismissal(const QVariantMap &alert){
+ if(!m_continuity||m_mergingShared||!sharedAlert(alert))return;
+ auto id=alert.value("id").toString(),hash=alert.value("stateHash").toString();
+ auto key=ContinuityProvider::contentKey(id.toUtf8()+QByteArray(1,'\0')+hash.toUtf8());
+ m_continuity->mutate("put","alerts",key,{{"alertId",id},{"stateHash",hash},{"dismissed",true}});
+}
+void AlertsProvider::mergeAcknowledgements(){
+ if(!m_continuity||m_mergingShared)return;m_mergingShared=true;
+ const auto alerts=m_allAlerts;
+ for(const auto &v:alerts){auto alert=v.toMap();if(!sharedAlert(alert))continue;
+  for(const auto &a:m_continuity->items("alerts")){auto p=a.toMap().value("payload").toMap();
+   if(p.value("dismissed").toBool()&&p.value("alertId")==alert.value("id")&&p.value("stateHash")==alert.value("stateHash")){
+    auto key=AlertsParsers::stateKey(alert.value("id").toString(),alert.value("stateHash").toString());
+    if(!m_dismissedKeys.contains(key))dismiss(alert.value("id").toString(),alert.value("stateHash").toString());
+   }
+  }
+ }
+ m_mergingShared=false;
+}
