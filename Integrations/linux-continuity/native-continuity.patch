+DESK_COMMANDS = frozenset(('status', 'capabilities', 'search', 'submit', 'jobs', 'list', 'job', 'cancel', 'archive', 'retry', 'result', 'retrieve', 'download', 'deskflow', 'input_status', 'input_start', 'input_stop', 'input_home', 'input_layout', 'input_mode'))
