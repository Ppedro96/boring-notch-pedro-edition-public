+    for (const auto& v : frame.value("items").toList()) {
+        auto entry = v.toMap();
+        auto id = entry.value("id").toString();
+        auto p = entry.value("payload").toMap();
+        incoming.insert(id);
+        QVariantMap item { { "id", id },
+            { "text", p.value("kind") == "image" ? QVariant("Imagem PNG") : p.value("text") },
+            { "kind", p.value("kind") },
+            { "timestamp", qint64(p.value("capturedAt").toDouble() * 1000) },
+            { "pinned", p.value("pinned").toBool() }, { "blob", p.value("blob") },
+            { "origin", entry.value("origin") }, { "shared", true } };
+        for (const auto& old : previous)
+            if (old.toMap().value("id") == id && old.toMap().contains("path"))
+                item["path"] = old.toMap().value("path");
+        result << item;
+        bool alreadyCaptured = false;
+        for (const auto& old : previous)
+            if (old.toMap().value("id") == id
+                && old.toMap().value("timestamp").toLongLong()
+                    >= item.value("timestamp").toLongLong())
+                alreadyCaptured = true;
+        if (!alreadyCaptured
+            && ContinuityProvider::freshClipboard(
+                frame, entry, m_continuity->peer(), nowOr(-1) / 1000.0, newest)) {
+            automatic = item;
+            newest = p.value("capturedAt").toDouble();
