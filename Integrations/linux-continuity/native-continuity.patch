+            QTRY_VERIFY(!applications.isEmpty());
+            QVERIFY(applications.last().at(1).toBool());
+            QCOMPARE(store.publishedBytes(), incoming);
+        }
+        store.startMonitoring(nullptr);
+        p.stop();
