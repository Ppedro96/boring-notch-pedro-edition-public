+void DeskProvider::consume(const QString& cmd, const QVariantMap& value)
+{
+    if (!value.value("ok").toBool()) {
+        if (cmd == "deskflow")
+            m_desk["stale"] = true;
+        m_message = value.value("error", "Integração indisponível ou tempo esgotado").toString();
+    } else {
+        if (cmd == "capabilities")
+            m_hosts = value.value("hosts").toList();
+        else if (cmd == "jobs") {
+            m_jobs = value.value("jobs").toList();
+            m_jobs.append(value.value("localHistory").toList());
+        } else if (cmd == "search") {
+            m_results = value.value("results").toList();
+            m_message = QString("%1 arquivos encontrados").arg(m_results.size());
+            const auto errors = value.value("warnings").toList();
+            if (!errors.isEmpty())
+                m_message += " · Algumas máquinas indisponíveis";
+        } else if (cmd == "deskflow" || cmd == "input_layout") {
+            m_desk = value;
+            m_desk["permissionRequired"]
+                = value.value("detail").toString().contains("does not trust");
+        } else {
+            if (cmd == "result" && value.contains("output"))
+                openFile(value.value("output").toString());
+            m_message = value.contains("output") ? "Salvo em " + value.value("output").toString()
+                                                 : "Solicitação concluída";
+            request({ { "command", "jobs" } });
+        }
+    }
+
+    emit changed();
+}
+void DeskProvider::request(const QVariantMap& r)
+{
+    const QString cmd = r.value("command").toString();
+    if (m_pending.contains(cmd))
+        return;
+    m_pending.insert(cmd);
+    emit changed();
+    if (m_continuity && m_continuity->enabled()) {
+        m_continuity->request(
+            { { "op", "desk_local" }, { "request", r } },
+            [this, cmd](const QVariantMap& reply) {
+                m_pending.remove(cmd);
+                consume(cmd, reply.value("ok").toBool() ? reply.value("result").toMap() : reply);
+            },
+            cmd == "submit" || cmd == "result" || cmd == "fetch" ? 3600000
+                : cmd == "deskflow" || cmd == "input_layout"     ? 75000
+                                                                 : 45000);
+        return;
+    }
+    auto* process = new QProcess(this);
+    connect(process, &QProcess::readyReadStandardError, process,
+        [process] { process->readAllStandardError(); });
+    auto* deadline = new QTimer(process);
+    deadline->setSingleShot(true);
+    connect(deadline, &QTimer::timeout, process, [process] { process->kill(); });
+    connect(process, &QProcess::errorOccurred, this,
+        [this, process, cmd](QProcess::ProcessError error) {
+            if (error == QProcess::FailedToStart) {
+                m_pending.remove(cmd);
+                m_message = "Não foi possível iniciar a integração";
+                emit changed();
+                process->deleteLater();
+            }
+        });
+    connect(process, qOverload<int, QProcess::ExitStatus>(&QProcess::finished), this,
+        [this, process, cmd, deadline](int, QProcess::ExitStatus) {
+            deadline->stop();
+            m_pending.remove(cmd);
+            const auto doc = QJsonDocument::fromJson(process->readAllStandardOutput());
+            const auto value = doc.object().toVariantMap();
+            consume(cmd, value);
+            emit changed();
+            process->deleteLater();
+        });
+    const QString script = QDir::homePath() + "/.local/share/insight-notch-linux/desk/desk-hub.py";
+    process->start("/usr/bin/python3", { script });
+    process->write(QJsonDocument::fromVariant(r).toJson(QJsonDocument::Compact));
+    process->closeWriteChannel();
+    deadline->start(cmd == "fetch" ? 3600000 : cmd == "deskflow" ? 75000 : 45000);
+}
