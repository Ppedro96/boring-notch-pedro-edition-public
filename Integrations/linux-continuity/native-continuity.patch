+        if op == 'upload_chunk':
+            return self.store.upload_chunk(self.peer, request['uploadId'], request['offset'], request['data'])
+        if op == 'upload_finish':
+            return self.store.upload_finish(self.peer, request['uploadId'])
+        if op == 'blob_read':
