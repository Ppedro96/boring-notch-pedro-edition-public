+void ClipboardStoreTest::largeStartupCacheYieldsToEventLoop()
+{
+    QTemporaryDir root;
+    const auto directory = root.path() + "/clipboard-images";
+    QVERIFY(QDir().mkpath(directory));
+    const auto bytes = pngBytes();
+    for (int n = 0; n < 320; ++n)
+        QVERIFY(writeBytes(directory + "/" + QString::number(n, 16).rightJustified(64, '0') + ".png", bytes));
+    ClipboardStore store(root.path());
+    bool partialProgressObserved = false;
+    QTimer heartbeat;
+    connect(&heartbeat, &QTimer::timeout, this, [&] {
+        const auto remaining = QDir(directory).entryList(QDir::Files).size();
+        partialProgressObserved |= remaining > 0 && remaining < 320;
+    });
+    heartbeat.start(10);
+    QTRY_VERIFY(QDir(directory).entryList(QDir::Files).isEmpty());
+    QVERIFY(partialProgressObserved);
+    // Ordinary text capture never restarts a completed image-cache walk.
+    store.recordText("one");
+    store.recordText("two");
+    QVERIFY(!store.m_imageCleanupTimer->isActive());
+}
