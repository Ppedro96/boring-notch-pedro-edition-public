+#!/usr/bin/python3
+"""Foreground wl-copy CLI fixture: private files only, no compositor or desktop access."""
+import json, os, pathlib, signal, subprocess, sys, time
+root = pathlib.Path(__file__).parent
+assert len(sys.argv) == 4 and sys.argv[1:3] == ['--foreground', '--type']
+mode = (root / 'mode').read_text() if (root / 'mode').exists() else 'normal'
+with (root / 'processes.jsonl').open('a') as out:
+    out.write(json.dumps({'pid': os.getpid(), 'args': sys.argv[1:]}) + '\n')
+signal.signal(signal.SIGTERM, signal.SIG_IGN)
+if mode in ('descendant', 'descendant-exit'):
+    child = subprocess.Popen([sys.executable, '-c', 'import signal,time; signal.signal(signal.SIGTERM,signal.SIG_IGN); time.sleep(60)'])
+    (root / 'descendant').write_text(str(child.pid))
+if mode == 'descendant-exit':
+    time.sleep(.03)
+    os._exit(3)
+if mode == 'never-read':
+    time.sleep(60)
+sys.stderr.write('e' * 262144)
+sys.stderr.flush()
+value = sys.stdin.buffer.read()
+(root / 'published.bin').write_bytes(value)
+if mode != 'no-offer':
+    (root / 'current.bin').write_bytes(value)
+    (root / 'types').write_text(sys.argv[3] + '\n')
+(root / 'committed').write_text(str(os.getpid()))
+if mode == 'handoff':
+    sys.exit(0)
+while True:
+    time.sleep(1)
