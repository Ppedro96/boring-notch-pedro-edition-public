+protected:
+    QString waylandCopyProgram() const override { return copyProgram; }
+    void readWayland(
+        const QStringList& args, qsizetype, std::function<void(bool, QByteArray)> done) override
+    {
+        const int call = ++reads;
+        QTimer::singleShot(1, this, [this, args, done, call] {
+            if (beforeReply)
+                beforeReply(call);
+            const auto root = QFileInfo(copyProgram).path();
+            const auto offerBytes
+                = QFile::exists(root + "/types") ? readFile(root + "/types") : offer;
+            const auto current
+                = QFile::exists(root + "/current.bin") ? readFile(root + "/current.bin") : content;
+            done(true, args.contains("--list-types") ? offerBytes : current);
+        });
+    }
+};
