+        if (timeout) {
+            QVERIFY(writeBytes(root.path() + "/release-worker", "ready"));
+            QTRY_VERIFY(QFile::exists(root.path() + "/started1"));
+            QCOMPARE(readBytes(cachePath(root.path() + "/history", bytes)), bytes);
+        }
+        QVERIFY(writeBytes(root.path() + "/release1",
+            outcome.endsWith("failure") ? QByteArray("failure") : outcome.toUtf8()));
+        QTRY_VERIFY(QFile::exists(root.path() + "/read1"));
+        QCOMPARE(readBytes(root.path() + "/read1"), bytes);
+        if (outcome == "overlap") {
+            QTRY_VERIFY(QFile::exists(root.path() + "/started2"));
+            QTest::qWait(450);
+            QCOMPARE(readBytes(cachePath(root.path() + "/history", bytes)), bytes);
+            QVERIFY(writeBytes(root.path() + "/release2", "failure"));
+            QTRY_VERIFY(QFile::exists(root.path() + "/read2"));
+            QCOMPARE(readBytes(root.path() + "/read2"), bytes);
+        }
+    }
+    QTRY_VERIFY(!QFile::exists(cachePath(root.path() + "/history", bytes)));
+    QVERIFY(store.items().isEmpty());
+    QVERIFY(store.m_imageTransfers.isEmpty());
+    if (timeout) {
