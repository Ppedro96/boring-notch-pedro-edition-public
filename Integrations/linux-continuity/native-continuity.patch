+void ClipboardStore::save()
+{
+    QDir().mkpath(m_dataRoot);
+    QFile::setPermissions(
+        m_dataRoot, QFileDevice::ReadOwner | QFileDevice::WriteOwner | QFileDevice::ExeOwner);
+    auto write = [this](const QString& name, const QJsonDocument& doc) {
+        QSaveFile f(QDir(m_dataRoot).filePath(name));
+        if (!f.open(QIODevice::WriteOnly))
+            return false;
+        f.setPermissions(QFileDevice::ReadOwner | QFileDevice::WriteOwner);
+        const auto bytes = doc.toJson(QJsonDocument::Compact);
+        return f.write(bytes) == bytes.size() && f.commit();
+    };
+    if (write("clipboard.json", QJsonDocument::fromVariant(m_items))) {
+        const auto references = imageReferences(m_items);
+        const bool changed = !m_historyReadable || references != m_persistedImagePaths;
+        m_persistedImagePaths = references;
+        m_historyReadable = true;
+        if (changed)
+            scheduleImageCleanup();
+    }
+    write("clipboard-shared.json",
+        QJsonDocument::fromVariant(QStringList(m_knownShared.begin(), m_knownShared.end())));
