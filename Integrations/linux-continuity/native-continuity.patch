+            QVERIFY(png.save(root.path() + "/source.png", "PNG"));
+            QFile f(root.path() + "/source.png");
+            QVERIFY(f.open(QIODevice::ReadOnly));
+            incoming = f.readAll();
+            if (source == "cachedPNG")
+                store.recordImage(incoming, QDateTime::currentMSecsSinceEpoch() - 10000);
+        }
+        auto board = QGuiApplication::clipboard();
+        board->setText("observed");
+        store.startMonitoring(board);
+        QTRY_VERIFY(store.items().size() >= (source == "cachedPNG" ? 2 : 1));
+        store.reads = 0;
+        store.setContinuity(&p);
+        QSignalSpy applications(&store, &ClipboardStore::applicationFinished);
+        QSignalSpy writes(board, &QClipboard::dataChanged);
+        store.beforeReply = [&](int call) {
+            if (change == "content" && call == 1)
+                store.content = "new local copy without Qt signal";
+            if (change == "formats" && call == 3)
+                store.offer += "x-kde-passwordManagerHint\n";
+            if (change == "precommit" && call == 4)
+                store.content = "new local copy while writer starts";
+            if (change == "precommit-generation" && call == 4)
+                board->setText("new Qt generation");
+            if (change == "generation" && call == 2) {
+                store.content = "new Qt generation";
+                board->setText("new Qt generation");
+            }
+        };
+        QTest::qWait(5);
+        const auto id = ContinuityProvider::contentKey(incoming);
+        emit p.snapshotReceived(frame({ item(id,
+            { { "kind", source == "text" ? "text" : "image" },
+                { "text", source == "text" ? QString::fromUtf8(incoming) : QString() },
+                { "capturedAt", QDateTime::currentMSecsSinceEpoch() / 1000.0 },
+                { "blob",
+                    QVariantMap { { "sha256", id }, { "size", incoming.size() },
+                        { "name", "source.png" } } } }) }));
+        QTRY_VERIFY(store.reads >= 2);
+        if (change == "none") {
+            QTRY_VERIFY(!applications.isEmpty());
+            QVERIFY(applications.last().at(1).toBool());
+            QCOMPARE(store.publishedBytes(), incoming);
+            QCOMPARE(writes.count(), 0); // The production Wayland path never calls Qt's setter.
+            // A delayed/stale Qt notification must read the current OS offer and not republish
+            // the old Qt text as a new local copy.
+            board->setText("stale Qt text");
+            QTest::qWait(100);
+            QFile log(root.path() + "/requests.jsonl");
+            QVERIFY(log.open(QIODevice::ReadOnly));
+            const auto requests = log.readAll();
+            for (const auto& line : requests.split('\n')) {
+                const auto request = QJsonDocument::fromJson(line).object();
+                QVERIFY(request.value("op") != "put" || request.value("topic") != "clipboard");
+            }
+        } else {
+            if (change.startsWith("precommit"))
+                QTRY_VERIFY(!applications.isEmpty());
+            QTest::qWait(50);
+            QVERIFY(!store.published()); // EOF was never released for the newer local offer.
+            QCOMPARE(board->text(),
+                change.endsWith("generation") ? QString("new Qt generation") : QString("observed"));
+            QCOMPARE(writes.count(), change.endsWith("generation") ? 1 : 0);
