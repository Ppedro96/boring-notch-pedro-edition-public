+namespace {
+QByteArray pngBytes(QRgb color = qRgb(10, 20, 30))
+{
+    QImage image(2, 2, QImage::Format_RGB32);
+    image.fill(color);
+    QByteArray bytes;
+    QBuffer buffer(&bytes);
+    buffer.open(QIODevice::WriteOnly);
+    image.save(&buffer, "PNG");
+    return bytes;
+}
+bool writeBytes(const QString& path, const QByteArray& bytes)
+{
+    QFile file(path);
+    return file.open(QIODevice::WriteOnly) && file.write(bytes) == bytes.size();
+}
+QByteArray readBytes(const QString& path)
+{
+    QFile file(path);
+    return file.open(QIODevice::ReadOnly) ? file.readAll() : QByteArray();
+}
+QString cachePath(const QString& root, const QByteArray& bytes)
+{
+    return root + "/clipboard-images/" + ContinuityProvider::contentKey(bytes) + ".png";
+}
+}
+void ClipboardStoreTest::retiresImagesPreservingPinnedSharedAndExactBytes()
+{
+    QTemporaryDir root;
+    QVERIFY(root.isValid());
+    ClipboardStore store(root.path());
+    const auto first = pngBytes(), pinned = pngBytes(qRgb(50, 60, 70));
+    const auto shared = pngBytes(qRgb(80, 90, 100));
+    store.recordImage(first, 0);
+    const auto pin = store.recordImage(pinned, 0);
+    store.togglePin(pin);
+    const auto sharedId = store.recordImage(shared, 0);
+    ContinuityProvider provider(root.path() + "/absent-config");
+    store.setContinuity(&provider);
+    // A shared reference survives retention even without a local path in the remote payload.
+    emit provider.snapshotReceived({ { "topic", "clipboard" }, { "initial", true },
+        { "items", QVariantList { QVariantMap { { "id", sharedId },
+            { "payload", QVariantMap { { "kind", "image" }, { "capturedAt", 0 } } } } } } });
+    store.prune(15LL * 24 * 60 * 60 * 1000);
+    QTRY_VERIFY(!QFile::exists(cachePath(root.path(), first)));
+    QCOMPARE(readBytes(cachePath(root.path(), pinned)), pinned);
+    QCOMPARE(readBytes(cachePath(root.path(), shared)), shared);
+    store.clear();
+    QTRY_VERIFY(!QFile::exists(cachePath(root.path(), shared)));
+    QCOMPARE(readBytes(cachePath(root.path(), pinned)), pinned);
+    store.remove(pin);
+    QTRY_VERIFY(!QFile::exists(cachePath(root.path(), pinned)));
+}
+void ClipboardStoreTest::countRetentionAndDuplicateIdentity()
+{
+    QTemporaryDir root;
+    ClipboardStore store(root.path());
+    const auto bytes = pngBytes();
+    const auto id = store.recordImage(bytes, 1000);
+    store.recordImage(bytes, 2000);
+    QCOMPARE(store.items().size(), 1);
+    for (int n = 0; n < 99; ++n)
+        store.recordText(QString::number(n), 3000 + n);
+    QTest::qWait(400);
+    QCOMPARE(readBytes(cachePath(root.path(), bytes)), bytes);
+    store.recordText("evicts oldest unpinned", 4000);
+    QTRY_VERIFY(!QFile::exists(cachePath(root.path(), bytes)));
+    QVERIFY(!id.isEmpty());
+    QCOMPARE(store.items().size(), 100);
+}
+void ClipboardStoreTest::startupCleanupIgnoresUnknownExternalAndSymlinkFiles()
+{
+    QTemporaryDir root, external;
+    const auto dir = root.path() + "/clipboard-images";
+    QVERIFY(QDir().mkpath(dir));
+    const auto bytes = pngBytes();
+    const auto orphan = cachePath(root.path(), bytes);
+    QVERIFY(writeBytes(orphan, bytes));
+    QVERIFY(writeBytes(dir + "/notes.txt", "unknown"));
+    QVERIFY(writeBytes(dir + "/original.png", bytes));
+    const auto unknownSuffix = dir + "/" + QString(64, 'd') + ".png\n";
+    QVERIFY(writeBytes(unknownSuffix, bytes));
