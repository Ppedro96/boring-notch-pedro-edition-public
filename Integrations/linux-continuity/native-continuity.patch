+    auto write = [this, guard, id, observed, generation, item, automatic](const QByteArray& data) {
+        if (!guard || generation != m_generation)
+            return;
+        if (automatic && nowOr(-1) / 1000.0 - item.value("timestamp").toLongLong() / 1000.0 > 30)
+            return;
+        bool exists = false;
+        for (const auto& v : m_items)
+            if (v.toMap().value("id") == id)
+                exists = true;
+        if (!exists)
+            return;
+        if (key(data) != id)
+            return;
+        if (item.value("kind") == "image"
+            && (data.size() > 20 * 1024 * 1024 || QImage::fromData(data, "PNG").isNull()))
+            return;
+        if (qEnvironmentVariable("XDG_SESSION_TYPE") == "wayland") {
+            writeWayland(data,
+                item.value("kind") == "image" ? "image/png" : "text/plain;charset=utf-8", id,
+                observed, generation, automatic, item.value("timestamp").toLongLong());
+            return;
+        }
+        m_applying = true;
+        m_lastObservedKey = id;
+        m_lastCapture = nowOr(-1) / 1000.0;
+        auto mime = new QMimeData;
+        if (item.value("kind") == "image")
+            mime->setData("image/png", data);
+        else
+            mime->setText(QString::fromUtf8(data));
+        m_clipboard->setMimeData(mime);
+        m_applying = false;
+        emit applicationFinished(id, true);
+    };
+    // Every automatic path must compare the current OS offer with the last observed local
+    // content. Qt may not emit dataChanged for a background Wayland copy before our poll.
+    auto guardedWrite
+        = [this, guard, generation, observed, automatic, commit = write](const QByteArray& bytes) {
+              if (!guard || generation != m_generation)
+                  return;
+              if (!automatic || qEnvironmentVariable("XDG_SESSION_TYPE") != "wayland") {
+                  commit(bytes);
+                  return;
+              }
+              readWaylandOffer(
+                  [this, guard, generation, observed, commit, bytes](bool ok, QByteArray current) {
+                      if (guard && ok && generation == m_generation && key(current) == observed)
+                          commit(bytes);
+                  });
+          };
+    if (item.value("kind") != "image") {
+        guardedWrite(item.value("text").toString().toUtf8());
+        return;
+    }
+    auto path = item.value("path").toString();
+    if (!path.isEmpty()) {
+        QFile file(path);
+        if (file.open(QIODevice::ReadOnly)) {
+            auto bytes = file.read(20 * 1024 * 1024 + 1);
+            if (key(bytes) == id) {
+                guardedWrite(bytes);
+                return;
+            }
+        }
+    }
+    if (m_continuity) {
+        m_continuity->request(
+            { { "op", "fetch_blob" }, { "blob", item.value("blob") } },
+            [guard, guardedWrite](const QVariantMap& r) {
+                if (!guard || !r.value("ok").toBool())
+                    return;
+                QFile file(r.value("path").toString());
+                if (!file.open(QIODevice::ReadOnly))
+                    return;
+                const auto bytes = file.read(20 * 1024 * 1024 + 1);
+                guardedWrite(bytes);
+            },
+            120000);
+    }
