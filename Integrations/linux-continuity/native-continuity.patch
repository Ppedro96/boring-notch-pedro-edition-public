+        const QVariantMap& payload = {}, Reply callback = {});
+    void setLocalMedia(const QVariantMap& snapshot);
+    void publishTasks(const QVariantList& sessions);
+    void acknowledge(const QString& id, bool ok, const QString& error = {});
+    void publishLink(
+        const QString& title, const QString& url, const QString& note, const QString& path);
+    Q_INVOKABLE void selectHost(const QString& host);
+    Q_INVOKABLE void mediaAction(const QString& action, double position = 0);
+    Q_INVOKABLE void addShelf(const QVariant& urlOrText);
