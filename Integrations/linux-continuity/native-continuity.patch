+#pragma once
+#include <QObject>
+#include <QProcess>
+#include <QTimer>
+
+// Owns one foreground selection source. EOF is withheld until the caller revalidates
+// the current clipboard; the process serves repeated pastes until ownership is lost.
+class WaylandClipboardWriter final : public QObject {
+    Q_OBJECT
+public:
+    explicit WaylandClipboardWriter(QObject* parent = nullptr);
+    ~WaylandClipboardWriter() override;
+    void start(const QString& program, const QByteArray& bytes, const QString& mime);
+    void commit();
+    void confirm();
+    void stop();
+    bool running() const;
+    bool committed() const { return m_committed; }
+    bool selectionReleased() const { return m_committed && m_released; }
+signals:
+    void prepared();
+    void failed(const QString& reason);
+    void finished();
+
+private:
+    void checkPrepared();
+    void fail(const QString& reason);
+    QProcess m_process;
+    QTimer m_deadline;
+    QByteArray m_bytes;
+    qint64 m_group = 0;
+    bool m_prepared = false, m_committed = false, m_confirmed = false, m_stopping = false,
+         m_released = false;
+};
