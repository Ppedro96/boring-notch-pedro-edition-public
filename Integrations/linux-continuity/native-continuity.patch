+    QVERIFY(writeBytes(outside, bytes));
+    const auto link = dir + "/" + QString(64, 'a') + ".png";
+    QVERIFY(QFile::link(outside, link));
+    const auto nested = dir + "/nested";
+    QVERIFY(QDir().mkpath(nested));
+    QVERIFY(writeBytes(nested + "/" + QString(64, 'b') + ".png", bytes));
+    ClipboardStore store(root.path());
+    QTRY_VERIFY(!QFile::exists(orphan));
+    QCOMPARE(readBytes(outside), bytes);
+    QVERIFY(QFileInfo(link).isSymLink());
+    QCOMPARE(readBytes(dir + "/original.png"), bytes);
+    QCOMPARE(readBytes(unknownSuffix), bytes);
+    QCOMPARE(readBytes(dir + "/notes.txt"), QByteArray("unknown"));
+    QVERIFY(QFile::exists(nested + "/" + QString(64, 'b') + ".png"));
+    // A symlink replacing the entire owned directory must also be ignored.
+    QTemporaryDir linkedRoot;
