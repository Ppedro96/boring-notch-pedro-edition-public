+    void readOutput();
+    void handleFrame(const QVariantMap& frame);
+    void cleanup(bool restart);
+    void finishCleanup();
+    void failPending(const QString& reason);
+    void feedback(const QString& value);
+    void publishMedia();
+    QVariantMap find(const QString& topic, const QString& key) const;
+    QString m_config, m_script, m_peer, m_state = "disabled", m_message, m_selectedHost;
+    bool m_groupKilled = false;
+    bool m_enabled = false, m_stopping = false, m_handshake = false, m_cleaning = false;
+    int m_ownedGroup = 0, m_restartDelay = 200, m_cleanupTicks = 0;
