+void ClipboardStore::load()
+{
+    QFile f(QDir(m_dataRoot).filePath("clipboard.json"));
+    m_historyReadable = !f.exists();
+    if (f.open(QIODevice::ReadOnly)) {
+        auto doc = QJsonDocument::fromJson(f.readAll());
+        m_historyReadable = f.error() == QFileDevice::NoError && doc.isArray();
+        if (m_historyReadable)
+            m_items = doc.array().toVariantList();
